-- 👁️ ระบบ ESP
-- ==========================================
local espObjects = {}

local function createESP(targetPlayer)
    if targetPlayer == player then return end
    if espObjects[targetPlayer] then return end
    
    local data = {
        Player = targetPlayer,
        Connections = {},
    }
    
    espObjects[targetPlayer] = data
end

local function removeESP(targetPlayer)
    local data = espObjects[targetPlayer]
    if not data then return end
    
    for _, obj in pairs(data) do
        if typeof(obj) == "Instance" then obj:Destroy() end
    end
    for _, conn in pairs(data.Connections or {}) do
        if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() end
    end
    
    espObjects[targetPlayer] = nil
end

for _, p in ipairs(Players:GetPlayers()) do
    createESP(p)
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- อัปเดต ESP ทุกเฟรม
RunService.RenderStepped:Connect(function()
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    
    for targetPlayer, data in pairs(espObjects) do
        local char = targetPlayer.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        
        local visible = Settings.ESPEnabled and char and head and hrp and humanoid and humanoid.Health > 0
        
        -- Team check
        if visible and Settings.TeamCheck and player.Team and targetPlayer.Team == player.Team then
            visible = false
        end
        
        -- ระยะไกลเกิน
        if visible and myRoot then
            local dist = (myRoot.Position - hrp.Position).Magnitude
            if dist > Settings.MaxDistance then visible = false end
        end
        
        if not visible then
            if data.Highlight then data.Highlight.Enabled = false end
            if data.Box then data.Box.Enabled = false end
            if data.NameTag then data.NameTag.Enabled = false end
            if data.HealthTag then data.HealthTag.Enabled = false end
            continue
        end
        
        -- Highlight
        if not data.Highlight then
            local hl = Instance.new("Highlight")
            hl.Name = "ESP_HL"
            hl.FillTransparency = 0.6
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            data.Highlight = hl
        end
        data.Highlight.Enabled = true
        data.Highlight.Adornee = char
        data.Highlight.FillColor = Settings.ESPColor
        data.Highlight.OutlineColor = Settings.ESPColor
        
        -- Name Tag
        if not data.NameTag then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ESP_Name"
            bb.Size = UDim2.new(0, 200, 0, 40)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.Parent = char
            
            local nameLbl = Instance.new("TextLabel")
            nameLbl.Name = "Name"
            nameLbl.Size = UDim2.new(1, 0, 0.6, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = targetPlayer.Name
            nameLbl.TextColor3 = Settings.ESPColor
            nameLbl.TextStrokeTransparency = 0
            nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLbl.TextScaled = true
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.Parent = bb
            
            local distLbl = Instance.new("TextLabel")
            distLbl.Name = "Distance"
            distLbl.Size = UDim2.new(1, 0, 0.4, 0)
            distLbl.Position = UDim2.new(0, 0, 0.6, 0)
            distLbl.BackgroundTransparency = 1
            distLbl.Text = "0m"
            distLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            distLbl.TextStrokeTransparency = 0
            distLbl.TextScaled = true
            distLbl.Font = Enum.Font.Gotham
            distLbl.Parent = bb
            
            data.NameTag = bb
            data.NameLabel = nameLbl
            data.DistanceLabel = distLbl
        end
        data.NameTag.Enabled = true
        data.NameTag.Adornee = head
        data.NameLabel.Text = targetPlayer.Name
        data.NameLabel.TextColor3 = Settings.ESPColor
        data.NameLabel.Visible = Settings.ShowName
        data.DistanceLabel.Visible = Settings.ShowDistance
        
        if myRoot then
            local dist = (myRoot.Position - hrp.Position).Magnitude
            data.DistanceLabel.Text = string.format("%.0f m", dist)
        end
        
        -- Health Bar
        if not data.HealthTag then
            local hb = Instance.new("BillboardGui")
            hb.Name = "ESP_Health"
            hb.Size = UDim2.new(0, 100, 0, 8)
            hb.StudsOffset = Vector3.new(0, -3.5, 0)
            hb.AlwaysOnTop = true
            hb.Parent = char
            
            local bg = Instance.new("Frame")
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            bg.BorderSizePixel = 0
            bg.Parent = hb
            
            local hbCorner = Instance.new("UICorner")
            hbCorner.CornerRadius = UDim.new(1, 0)
            hbCorner.Parent = bg
            
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(1, 0, 1, 0)
            fill.BackgroundColor3 = Color3.fromRGB(80, 200, 80)
            fill.BorderSizePixel = 0
            fill.Parent = bg
            
            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = fill
            
            data.HealthTag = hb
            data.HealthBar = fill
        end
        data.HealthTag.Enabled = Settings.ShowHealth
        data.HealthTag.Adornee = head
        
        local hpRatio = humanoid.Health / humanoid.MaxHealth
        data.HealthBar.Size = UDim2.new(hpRatio, 0, 1, 0)
        data.HealthBar.BackgroundColor3 = Color3.fromRGB(
            math.floor(255 * (1 - hpRatio)),
            math.floor(255 * hpRatio),
            0
        )
    end
end)

