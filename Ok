    isOpen = true
    main.Visible = true
    main.Size = UDim2.new(0, 280, 0, 460)
    main.Position = UDim2.new(0.5, -140, 0.5, -230)
    TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 300, 0, 500),
        Position = UDim2.new(0.5, -150, 0.5, -250),
    }):Play()
    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Theme.Danger
    }):Play()
end

local function closeUI()
    if not isOpen then return end
    isOpen = false
    TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 260, 0, 440),
        Position = UDim2.new(0.5, -130, 0.5, -220),
    }):Play()
    task.wait(0.2)
    main.Visible = false
    TweenService:Create(toggleBtn, TweenInfo.new(0.2), {
        BackgroundColor3 = Theme.Accent
    }):Play()
end

